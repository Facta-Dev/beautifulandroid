  "cards": [
    {
      "dot": "cyan",
      "title": "The credential boundary",
      "items": [
        "auth is Credential Manager (passkeys, passwords, Google) or AppAuth + Custom Tabs with PKCE \u2014 the app never handles a password",
        "the token is sealed by Keystore + Tink and read back through a TokenProvider port; never SharedPreferences, Room, logs or the APK",
        "the token lifecycle is explicit: register on login, refresh on change, revoke on logout \u2014 sign-out deletes the key and clears the local user data"
      ]
    },
    {
      "dot": "emerald",
      "title": "The server decides",
      "items": [
        "the server is authoritative for game state, prices, payments and entitlements; the client may hide an action, it never decides access",
        "root, emulator and Play Integrity are server-side risk signals, never a client block; certificate pinning only with a rotation plan",
        "authorization gates the destination server-side; the UI only shapes it, and a 403 is a rendered state rather than an empty screen"
      ]
    },
    {
      "dot": "rose",
      "title": "Signed out, offline, forbidden",
      "items": [
        "a deep link received while signed out is queued and resumed after login; no state-changing action is ever taken from a link",
        "every screen state is rendered, including offline and forbidden \u2014 one sealed UiState, never independent booleans",
        "the FCM token is registered on login, refreshed on change and revoked on logout; the payload is { v, type, id, route }"
      ]
    }
  ]
}
